# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# bun (bun.lock is committed; other package managers are not used here)
.bun/
package-lock.json
yarn.lock
pnpm-lock.yaml

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# postgres backups (scripts/backup-postgres.sh) — local artifacts, never committed
/backups/

# Python bytecode — never useful in the repo, and it dirties the working
# tree on every test run, which silently blocks rebases.
__pycache__/
*.pyc
*.pyo

# Python packaging/build output (setuptools `build/`, `dist/`, `*.egg-info/`)
# and test/type-checker caches. These are regenerated by every
# `pip install`/`pytest`/`mypy` run, so committing them causes the same
# always-dirty-tree problem as bytecode above — and egg-info can embed
# absolute local build paths, leaking filesystem layout.
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
