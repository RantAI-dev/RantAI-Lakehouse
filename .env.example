# RantAI Lakehouse — environment variable reference.
#
# Copy this file to `.env` before running `docker compose up` (compose
# auto-loads `.env` from the project root). Every variable and default here
# is harvested from `rust/crates/lakehouse-api/src/config.rs`, the
# authoritative source — see the README "Configuration" table for the full
# prose explanation of each one.
#
# This file contains NO real credentials and NO real infrastructure
# hostnames/IPs. Every default below is safe to run against the local
# `docker compose` stack (docker-compose.yml) as-is.

# ─────────────────────────────────────────────────────────────────────────
# REQUIRED — must set (there is no working default for these)
# ─────────────────────────────────────────────────────────────────────────

# Bootstrap admin account, seeded once at first boot (idempotent — safe to
# leave set across restarts). Without BOTH of these set, no admin account
# is created and there is DELIBERATELY no way to log in — see
# docs/OPERATIONS.md.
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=change-me-now

# ─────────────────────────────────────────────────────────────────────────
# Postgres (OLTP: identity, governance, pipelines, connectors, alerts, ...)
# ─────────────────────────────────────────────────────────────────────────

POSTGRES_USER=lakehouse
# This is the API's OWN database password. It is deliberately NOT what the
# seeded `conn-pg-lakehouse` connector dials with any more: migration 0023
# moved that to `CONNECTOR_PG_PASSWORD` (below), because allowlisting the
# console's own password for connector use let a `connector:manage`
# principal point a connector at a host they control and have the API
# authenticate to it with this value.
POSTGRES_PASSWORD=lakehouse
POSTGRES_DB=lakehouse

# Full connection string lakehouse-api uses. Defaults to the values above
# against the compose `postgres` service. NOTE: unlike PORT, an
# unreachable/misconfigured DATABASE_URL does NOT stop the process from
# booting — Phase 2 routes just start returning 503. See docs/OPERATIONS.md.
DATABASE_URL=postgres://lakehouse:lakehouse@postgres:5432/lakehouse

# ─────────────────────────────────────────────────────────────────────────
# ClickHouse (analytics: serving.* marts, catalog, lineage, BI)
# ─────────────────────────────────────────────────────────────────────────

CH_URL=http://clickhouse:8123
CH_USER=default
CH_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# Dagster (orchestration) — OUT OF SCOPE for the local compose stack.
# Dagster itself is not vendored here (it's heavy: a webserver + daemon +
# a code-location container). Leave these at their defaults; pipeline
# trigger/run-status routes will return 503 until you point them at a
# real Dagster instance.
# ─────────────────────────────────────────────────────────────────────────

# Running the `dagster` compose profile (P3)? Use the compose-internal
# address instead of this host-facing default, and set it HERE rather than
# prefixing it onto one `docker compose up` — a later `docker compose run`
# re-creates lakehouse-api and would otherwise drop back to the
# unreachable placeholder, silently 503-ing every Dagster-backed route:
#   DAGSTER_URL=http://dagster-webserver:3000/graphql
# See docs/OPERATIONS.md, "Dagster (opt-in, P3)".
DAGSTER_URL=http://localhost:13030/graphql
DAGSTER_REPO=__repository__
DAGSTER_LOCATION=dispar_orchestrate.definitions

# ─────────────────────────────────────────────────────────────────────────
# LLM (OpenAI-compatible chat completions) — OUT OF SCOPE for the local
# compose stack. Needs a real provider API key. Leave LLM_KEY empty and
# AI chat / agent / text-to-SQL routes will return 503 rather than fail
# to boot. Set LLM_URL/LLM_MODEL/LLM_KEY (or MINIMAX_API_KEY) to enable.
# ─────────────────────────────────────────────────────────────────────────

LLM_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3
LLM_KEY=
# MINIMAX_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Optional features — all safely unset by default
# ─────────────────────────────────────────────────────────────────────────

# HMAC signing secret for signed dashboard embeds. Unset disables embedding.
EMBED_SECRET=

# Shared bearer token required to call POST /api/alerts/run. Unset means
# the endpoint fails closed (401) — see the README's Security notes.
# Do NOT set this in a shared/example env; generate your own locally.
ALERTS_RUN_TOKEN=

# Outbound email for alert/digest delivery. Unset SMTP_HOST disables email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=rantai-lake@localhost

# OIDC / SSO. Both OIDC_ISSUER and OIDC_CLIENT_ID must be set for OIDC to
# be considered configured; unset means local password auth only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=default
OIDC_JWKS_URL=
OIDC_JIT_PROVISIONING=false
OIDC_ROLE_MAP=
OIDC_GROUPS_CLAIM=groups
OIDC_CLOCK_SKEW_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────
# Process-level (Rust-only, not ported from the old TypeScript backend)
# ─────────────────────────────────────────────────────────────────────────

PORT=8080
# "development" or "local" relaxes the session cookie's Secure attribute
# for local HTTP dev. Never bypasses authentication. Leave at "local" for
# `docker compose up`; use an unset/production value in real deployments.
APP_ENV=local

# ─────────────────────────────────────────────────────────────────────────
# Frontend (Next.js, read outside config.rs — see README "Configuration")
# ─────────────────────────────────────────────────────────────────────────

# Where the Next.js /api/* rewrite proxies to. Required to reach the
# backend at all when running `bun dev` against the compose stack.
RUST_API_URL=http://localhost:8080

# Build-time flag that shows/hides SSO login UI. See docs/OPERATIONS.md's
# proposal for a GET /api/auth/providers runtime replacement.
NEXT_PUBLIC_SSO_ENABLED=

# ─────────────────────────────────────────────────────────────────────────
# Object store (RustFS) — P1 infrastructure. These configure the RustFS
# service and the one-shot bucket-bootstrap job in docker-compose.yml
# (not read by config.rs directly — the P1b client-side counterparts,
# RUSTFS_S3_ENDPOINT etc., are further below). See docs/OPERATIONS.md.
# ─────────────────────────────────────────────────────────────────────────

# SECURITY: these are RustFS's own well-known defaults — override before
# exposing the RustFS listener beyond localhost. These are the object
# store's ROOT keys and are deliberately NOT what the seeded
# `conn-s3-warehouse` connector dials with any more: migration 0023 moved
# that to `CONNECTOR_S3_ACCESS_KEY`/`CONNECTOR_S3_SECRET_KEY` (below), so a
# connector can never name the store's root credentials by `secretRef` and
# have the API authenticate to a caller-chosen host with them.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# Bucket the bootstrap job creates (via the plain S3 API) for the lakehouse
# warehouse. Also read by config.rs as LAKEHOUSE_WAREHOUSE_BUCKET (P1b) —
# the same bucket name on both the compose-init side and the Rust client
# side, deliberately: they must agree or lakehouse-iceberg writes to a
# bucket the compose job never created.
LAKEHOUSE_WAREHOUSE_BUCKET=lakehouse-warehouse

# ─────────────────────────────────────────────────────────────────────────
# Iceberg REST catalog (Lakekeeper) — P1 infrastructure. These configure
# the `lakekeeper`, `lakekeeper-migrate`, and `lakekeeper-db-init` services
# themselves in docker-compose.yml (the P1b client-side counterparts,
# LAKEKEEPER_CATALOG_URI etc., are further below).
# ─────────────────────────────────────────────────────────────────────────

# Name of Lakekeeper's OWN Postgres database on the existing `postgres`
# service — deliberately separate from the `lakehouse` application
# database's `console` schema.
LAKEKEEPER_PG_DB=lakekeeper

# Encrypts secrets Lakekeeper stores in its own Postgres schema (storage
# credentials, once P1b registers a warehouse). CHANGE THIS before any
# non-throwaway use — the default below is Lakekeeper's own documented
# placeholder, not a real secret.
LAKEKEEPER_ENCRYPTION_KEY=this-is-not-a-secure-key-change-me

# Externally reachable base URL Lakekeeper advertises in its own REST
# responses. Defaults to the compose host-port mapping for local dev.
LAKEKEEPER_BASE_URI=http://localhost:8181

# ─────────────────────────────────────────────────────────────────────────
# lakehouse-iceberg client config — P1b. Read by config.rs; used to build
# an `lakehouse_iceberg::IcebergClientConfig` (no route calls this crate
# yet — P6 wires that up). Client-side counterparts of the service config
# above: these point AT the services from a Rust process, rather than
# configuring the services themselves.
# ─────────────────────────────────────────────────────────────────────────

# Lakekeeper's Iceberg REST catalog base URI, as reached from the Rust
# process (compose service name inside the network; localhost host-port
# mapping outside it).
LAKEKEEPER_CATALOG_URI=http://localhost:8181/catalog

# Lakekeeper warehouse this deployment writes Bronze tables into. See
# docs/adr/0003-tenant-lakekeeper-warehouse-mapping.md for the TENANT_ID
# naming convention.
LAKEKEEPER_WAREHOUSE=default

# secretRef (env:VAR_NAME shape — see lakehouse_core::secret, ADR 0002) for
# Lakekeeper's OAuth2 client-credential, when Lakekeeper authorization is
# enabled. Unset assumes Lakekeeper is running in no-auth (open) mode.
# LAKEKEEPER_CREDENTIAL_SECRET_REF=env:LAKEKEEPER_CREDENTIAL

# S3-compatible endpoint the lakehouse-iceberg object_store client targets.
# Defaults to the compose host-port mapping for local dev.
RUSTFS_S3_ENDPOINT=http://localhost:9010
RUSTFS_S3_REGION=us-east-1

# secretRef fields for a STATIC RustFS/S3 access key/secret — used only as
# a fallback outside the vended-credentials write path (see
# lakehouse-iceberg's crate doc comment). The G1 test does NOT use these.
# RUSTFS_ACCESS_KEY_SECRET_REF=env:RUSTFS_ACCESS_KEY
# RUSTFS_SECRET_KEY_SECRET_REF=env:RUSTFS_SECRET_KEY

# ─────────────────────────────────────────────────────────────────────────
# Host port mappings. Every service that publishes a port reads its host
# side from one of these, so a whole stack can be moved off the defaults
# without editing docker-compose.yml — necessary when another stack on the
# same machine already holds them.
# ─────────────────────────────────────────────────────────────────────────

POSTGRES_HOST_PORT=5432
CH_HTTP_HOST_PORT=8123
CH_NATIVE_HOST_PORT=9000
API_HOST_PORT=8080
RUSTFS_HOST_PORT=9010
RUSTFS_CONSOLE_HOST_PORT=9011
LAKEKEEPER_HOST_PORT=8181
OPENFGA_HTTP_HOST_PORT=8082
OPENFGA_GRPC_HOST_PORT=8083
OIDC_MOCK_HOST_PORT=8090
DAGSTER_WEBSERVER_HOST_PORT=3000
# NOT 8090 — oidc-mock publishes that, and the two collide the moment the
# `trino` profile runs alongside the base stack. Only takes effect if
# TRINO_PUBLISH_HOST_PORT is also set — see below.
TRINO_HOST_PORT=8091
SEAWEEDFS_S3_HOST_PORT=8333

# SECURITY: `trino` (the `trino` profile's compaction-only coordinator) has
# NO authentication of its own — anyone who can reach its port gets full
# `iceberg` catalog query access to every Bronze table. It is never
# published by default (`trino-maintenance-cron`, its only real consumer,
# reaches it in-network as `http://trino:8080`). CHANGE ME / leave unset:
# only set this to the literal string `trino` (not `true`/`1` — it is
# actually the Compose profile name being matched; see the `trino-host-port`
# service comment in docker-compose.yml for why) if you need ad-hoc host
# access to this catalog, and only on a host you trust every network-
# adjacent actor on.
# TRINO_PUBLISH_HOST_PORT=trino

# ─────────────────────────────────────────────────────────────────────────
# Tenant identity (`lakehouse-api/src/tenant.rs`). Each resolves to its
# historical default when left blank, so leaving these empty preserves
# existing behaviour exactly.
# ─────────────────────────────────────────────────────────────────────────

TENANT_OWNER=
TENANT_ID=
TENANT_DOMAIN=
TENANT_RESIDENCY=
TENANT_SITE=
TENANT_SOURCE=
BRONZE_CURATED_SLUGS=
CATALOG_NAMESPACE_META=
# Set to 0 on any tenant WITHOUT a `serving.mart_wisman` mart: the built-in
# "Main" dashboard's tiles are hardcoded to it and paint red before the UI
# redirects.
BUILTIN_DASHBOARD_ENABLED=1

# ─────────────────────────────────────────────────────────────────────────
# Bronze ingest (P3, dlt inside Dagster) and the Dagster metadata database
# ─────────────────────────────────────────────────────────────────────────

DAGSTER_PG_DB=dagster

# Postgres source dlt reads FROM (docker-compose.yml's
# `dagster-code-location`/`replication_metrics.py`). CREDENTIAL HYGIENE:
# these five replace what used to be a single `BRONZE_SOURCE_DATABASE_URL`
# DSN (`postgresql://user:password@host/db`) carried as one compose env
# var — a whole plaintext connection string, password included, visible
# to `docker inspect`. Split into components instead, matching
# `CONNECTOR_PG_PASSWORD` below: `BRONZE_SOURCE_DB_PASSWORD` defaults to
# `CONNECTOR_PG_PASSWORD` (falling back to `POSTGRES_PASSWORD`), not
# straight to `POSTGRES_PASSWORD`, for the same least-privilege-by-name
# reason `CONNECTOR_PG_PASSWORD` itself exists.
BRONZE_SOURCE_DB_HOST=postgres
BRONZE_SOURCE_DB_PORT=5432
# BRONZE_SOURCE_DB_USER/_PASSWORD/_NAME default from POSTGRES_USER /
# CONNECTOR_PG_PASSWORD / POSTGRES_DB in docker-compose.yml — set here only
# to override independently of those.
BRONZE_SOURCE_SCHEMA=ingest_demo
BRONZE_SOURCE_TABLE=orders
BRONZE_TABLE_NAME=g3a_orders
LAKEHOUSE_API_URL=http://lakehouse-api:8080
CH_RUSTFS_S3_ENDPOINT=http://rustfs:9000
CH_DB=default

# ─────────────────────────────────────────────────────────────────────────
# Catalog authorization (OpenFGA) and the alternate object store used only
# by the G2 storage-compatibility matrix
# ─────────────────────────────────────────────────────────────────────────

OPENFGA_PG_DB=openfga
LAKEKEEPER_OPENFGA_STORE_NAME=lakekeeper

# SECURITY: these are well-known local/CI defaults — override before
# exposing the SeaweedFS listener beyond localhost, same as
# RUSTFS_ACCESS_KEY/RUSTFS_SECRET_KEY above. Rendered into
# ops/seaweedfs/iam.json at bring-up by the `seaweedfs-iam-init` compose
# service, from ops/seaweedfs/iam.template.json — the committed
# `ops/seaweedfs/iam.json` this replaced is gone; see that service's
# comment in docker-compose.yml for why (it used to ship a working STS
# signing key to every checkout).
SEAWEEDFS_ACCESS_KEY=seaweedfsadmin
SEAWEEDFS_SECRET_KEY=seaweedfsadmin

# CHANGE ME BEFORE ANY DEPLOYMENT YOU RUN MORE THAN ONCE, or leave unset.
# Signs the STS tokens SeaweedFS issues for the G2 matrix warehouse.
# Leaving this UNSET is safe and is the recommended default: the
# `seaweedfs-iam-init` job generates a fresh random key per deployment
# (once, on first boot into an empty volume — see that service's comment)
# rather than falling back to any constant. Setting a value here yourself
# only matters if more than one container/host needs to agree on the same
# signing key (e.g. across a `docker compose down && up` you want to
# preserve tokens through) — in that case use a real random value of your
# own (`openssl rand -base64 32`), never a value copied from this file or
# from any example/docs.
SEAWEEDFS_STS_SIGNING_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Gold export to Iceberg (ADR 0010)
# ─────────────────────────────────────────────────────────────────────────

GOLD_SOURCE_SCHEMA=serving
GOLD_EXPORT_MARTS=gold_export_smoke
# Shared token required by POST /api/gold/export/{mart}. Generate your own.
GOLD_EXPORT_RUN_TOKEN=
GOLD_MART_NAME=gold_export_smoke
GOLD_EXPORT_ROW_COUNT=7
# Hard cap on rows a single export will read/append; a mart over this fails
# the export outright (named error) instead of silently truncating.
GOLD_EXPORT_MAX_ROWS=5000000
# Rows read from ClickHouse and appended to Iceberg per batch, instead of
# materializing the whole mart in memory at once.
GOLD_EXPORT_BATCH_SIZE=20000

# How often trino-maintenance-cron runs compaction over Bronze (seconds).
TRINO_CRON_INTERVAL_SECONDS=21600

# Credentials the SEEDED connectors dial with. Deliberately separate names
# from the API's own secrets: only these three are on the connector secret
# allowlist, so a connector can never name `POSTGRES_PASSWORD` (the console's
# own database password) or the RustFS root keys and have the API authenticate
# to a caller-chosen host with them. They default to the same values for the
# local stack; in a real deployment set them to least-privilege credentials
# scoped to what the connectors actually need.
#
# `CONNECTOR_S3_ACCESS_KEY`/`CONNECTOR_S3_SECRET_KEY` are ALSO what
# `dagster/dispar_orchestrate/dlt_pipeline.py` (dlt's Bronze write path)
# and `ops/g3/g3_loadgen.py` (the G3 load generator, run inside the same
# `dagster-code-location` container) authenticate to RustFS with now —
# credential-hygiene fix: both used to read `RUSTFS_ACCESS_KEY`/
# `RUSTFS_SECRET_KEY` (RustFS's own ROOT keys) directly, though neither
# needs more than PUT/GET on the warehouse bucket. They still default to
# the RustFS root key here because RustFS `1.0.0-rc.4` (this stack's
# pinned version) has no way to mint a narrower S3 identity through the
# plain S3 API this project's write path is restricted to (never a
# store's proprietary admin call — see docker-compose.yml's `rustfs`
# service comment); set these two to a real least-privilege identity in
# any deployment where your RustFS build/version can provide one.
CONNECTOR_PG_PASSWORD=lakehouse
CONNECTOR_S3_ACCESS_KEY=rustfsadmin
CONNECTOR_S3_SECRET_KEY=rustfsadmin

# CHANGE ME BEFORE ANY UNTRUSTED DEPLOYMENT.
# The connector connectivity probe refuses private/internal address ranges by
# default (SSRF guard). The compose stack's own seeded connectors point at
# `postgres:5432` and `http://rustfs:9000`, so it opts out. That opt-out
# travels with docker-compose.yml, which doubles as the host-agnostic
# deployment template — so this is `true` in a file you may deploy from. Set
# it to `false` anywhere that accepts connector definitions from untrusted
# callers, and give the seeded connectors externally-resolvable hosts.
CONNECTOR_PROBE_ALLOW_INTERNAL_HOSTS=true
