# RantAI Lakehouse — the settings a fresh install needs.
#
# Copy this file to `.env` before running `docker compose up` (compose
# auto-loads `.env` from the project root), or run `sh ops/init-env.sh`,
# which copies it and fills the empty secrets with generated values
# (it refuses to overwrite an existing `.env`).
#
# This file is deliberately SHORT. It holds the values only this install
# can know: the secrets the installer generates, and the choices that
# differ per deployment. Everything else has a default in
# `docker-compose.yml` or in the code; `docs/CONFIGURATION.md` lists
# every setting and says whether it is set here, commented out below, or
# documented only there.
#
# This file contains NO credentials and NO real infrastructure
# hostnames/IPs. SEC-18: the secrets below are EMPTY on purpose and
# docker-compose.yml refuses to start while a must-set one is empty, so
# copying this file as it is does not start the stack.

# ─────────────────────────────────────────────────────────────────────────
# Generated by the installer — leave empty here
# ─────────────────────────────────────────────────────────────────────────

# `sh ops/init-env.sh` (or `lakehousectl install`) fills every value in
# this section on a fresh install. Do not reuse another install's secrets
# and do not paste them into a shared file. `openssl rand -hex 24` makes
# a value for any of these by hand.
#
# The API's OWN Postgres password. MUST SET (SEC-18): compose refuses to
# start without it. It is deliberately NOT what the seeded
# `conn-pg-lakehouse` connector dials with: migration 0023 moved that to
# `CONNECTOR_PG_PASSWORD`, so a connector can never authenticate with the
# console's own database password.
POSTGRES_PASSWORD=

# Object store (RustFS) ROOT keys. MUST SET: compose refuses to start
# without them. The seeded `conn-s3-warehouse` connector uses
# `CONNECTOR_S3_ACCESS_KEY`/`_SECRET_KEY` instead (ADR 0002/0023).
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Encrypts the secrets Lakekeeper stores in its own Postgres schema.
# MUST SET: compose refuses to start without it. Changing it later makes
# the credentials Lakekeeper already stored unreadable, so keep it.
LAKEKEEPER_ENCRYPTION_KEY=

# The key managed connector credentials are encrypted with (AES-256-GCM,
# SRC-12). 32 random bytes in base64; `sh ops/init-env.sh` generates one.
# MUST SET: compose refuses to start without it. Keep a copy somewhere
# other than the credentials volume — losing it loses every stored
# connector credential.
CONNECTOR_SECRETS_KEY=

# First administrator, seeded once at first boot (idempotent). The email
# is in "Your choices" below; without BOTH lines set, no admin account is
# created and there is deliberately no way to log in — see
# docs/OPERATIONS.md.
AUTH_BOOTSTRAP_PASSWORD=

# Server-only key of the PDF print view's 2-minute token (BI-1). Its own
# secret: never reuse `EMBED_SECRET` (the embedding customer holds that
# one, and this token reads as whichever person it names).
RENDER_TOKEN_SECRET=

# Credentials every tenant warehouse is created with, when tenant
# provisioning is used (`POST /api/identity/tenants`). DEDICATED names:
# never alias `RUSTFS_ACCESS_KEY`/`_SECRET_KEY` (ADR 0002 Addendum 2).
# For a throwaway local stack they may hold the same values as the RustFS
# pair; `sh ops/init-env.sh` does exactly that.
TENANT_WAREHOUSE_S3_ACCESS_KEY=
TENANT_WAREHOUSE_S3_SECRET_KEY=

# SeaweedFS is the G2 storage-compatibility profile only. Compose reads
# the whole file whatever profile is active, so it cannot use `${X:?}`
# here; `--profile seaweedfs` refuses to start while either is empty.
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Your choices
# ─────────────────────────────────────────────────────────────────────────

# Bootstrap admin account (see the password above). Change the example
# address to one you can receive mail at.
AUTH_BOOTSTRAP_EMAIL=admin@example.com

# UUID of the tenant that owns this deployment's shared catalog and
# Dagster-job list. Neither has a tenant column, so with more than one
# tenant and this unset both are refused for any principal without the
# unrestricted grant, and every scheduled job is refused with a 422 that
# names this setting (SEC-50). `lakehousectl install` and `update` set it
# to the group tenant when it is empty (REL-10); a single-tenant
# deployment may leave it empty. See docs/CONFIGURATION.md.
CATALOG_TENANT_ID=

# The console's address as people open it, for example
# https://lakehouse.example.com. Scheduled report emails link to
# <this>/dashboards/<id>; unset or empty, the email carries no link. An
# address, not a credential.
CONSOLE_PUBLIC_URL=

# Days a backup is kept before the backup job removes it. Only read under
# the `backups` profile.
BACKUP_RETENTION_DAYS=30

# ─────────────────────────────────────────────────────────────────────────
# Published ports — move a whole stack off the defaults
# ─────────────────────────────────────────────────────────────────────────

# Every service that publishes a port reads its host side from one of
# these, so a second stack on the same machine only has to edit this
# block. The container side never changes.
POSTGRES_HOST_PORT=5432
CH_HTTP_HOST_PORT=8123
CH_NATIVE_HOST_PORT=9000
API_HOST_PORT=8080
CONSOLE_HOST_PORT=3000
RUSTFS_HOST_PORT=9010
RUSTFS_CONSOLE_HOST_PORT=9011
LAKEKEEPER_HOST_PORT=8181
# The Dagster webserver (`dagster` profile) is published on the host's
# loopback only: its UI has no sign-in, so anyone who can reach the port
# can launch runs. 3001, so it does not clash with the console's 3000.
DAGSTER_WEBSERVER_HOST_PORT=3001
# Trino's host port is only published when `TRINO_PUBLISH_HOST_PORT` is
# also set (docs/CONFIGURATION.md): Trino has no authentication of its
# own and reaches every Bronze table.
TRINO_HOST_PORT=8091
SEAWEEDFS_S3_HOST_PORT=8333

# ─────────────────────────────────────────────────────────────────────────
# Email — alerts, digests and scheduled reports
# ─────────────────────────────────────────────────────────────────────────
#
# Uncomment and fill to send alert and digest email and scheduled
# reports. `SMTP_CA_FILE` is the path INSIDE the API container to a PEM
# bundle for an internal relay whose certificate chains to a private CA
# (compose mounts the host directory `./ops/smtp-ca` at `/run/certs/smtp`).
# Until a relay is set, email is off and everything else works.
#
# Every setting: docs/CONFIGURATION.md#email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=rantai-lake@localhost
# SMTP_CA_FILE=

# ─────────────────────────────────────────────────────────────────────────
# Assistant — AI chat, agent and text-to-SQL
# ─────────────────────────────────────────────────────────────────────────
#
# Uncomment to point the assistant at an OpenAI-compatible chat-completions
# provider. Until a key is set, AI chat, agent and text-to-SQL routes
# answer 503 and the rest of the console works. The assistant's switches
# and timeout are in docs/CONFIGURATION.md.
#
# Every setting: docs/CONFIGURATION.md#assistant
# LLM_URL=https://api.minimax.io/v1
# LLM_MODEL=MiniMax-M3
# LLM_KEY=
# MINIMAX_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Single sign-on — OIDC
# ─────────────────────────────────────────────────────────────────────────
#
# Uncomment and set `OIDC_ISSUER` and `OIDC_CLIENT_ID` to enable OIDC. Both
# are required for it to count as configured. The three endpoint settings
# are only needed for the browser-redirect flow. The signing keys come
# from the issuer's discovery document unless `OIDC_JWKS_URL` overrides it.
#
# Every setting: docs/CONFIGURATION.md#single-sign-on
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=default
# OIDC_JWKS_URL=
# OIDC_JIT_PROVISIONING=false
# SEC-65: an existing account is joined by email only when the provider
# confirmed the address (`email_verified: true`). Turn this on only for a
# provider that never sends that claim; it is off by default.
# OIDC_TRUST_EMAIL=false
# OIDC_ROLE_MAP=
# OIDC_GROUPS_CLAIM=groups
# OIDC_AUTHORIZE_URL=
# OIDC_TOKEN_URL=
# OIDC_REDIRECT_URI=

# ─────────────────────────────────────────────────────────────────────────
# Secret managers — connectors reference a secret instead of holding it
# ─────────────────────────────────────────────────────────────────────────
#
# Set `SECRET_MANAGER` to vault, aws, gcp or azure and give the product
# the sign-in below; connectors can then reference a secret and the
# product reads it at every test and run, keeping no copy. Give it an
# identity that can read only the secrets it should. Unset keeps typed
# values only, which is the default.
#
# Every setting: docs/CONFIGURATION.md#secret-managers
# SECRET_MANAGER=
# SECRET_MANAGER_ALLOWED_PREFIXES=
# VAULT_ADDR=
# VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_ENDPOINT_URL_SECRETS_MANAGER=
# GOOGLE_APPLICATION_CREDENTIALS=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# CONNECTOR_TYPED_CREDENTIALS=

# ─────────────────────────────────────────────────────────────────────────
# Backups to S3 — the `backups` profile
# ─────────────────────────────────────────────────────────────────────────
#
# The backup job's OWN bucket, never the warehouse bucket: a dump holds
# password and service-token hashes. The `backups` profile refuses to
# start without the endpoint and credentials. `BACKUP_WAREHOUSE_*` is the
# read-only source side the mirror reads.
#
# Every setting: docs/CONFIGURATION.md#backups
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=lakehouse-backups
# BACKUP_S3_ACCESS_KEY_SECRET_REF=env:BACKUP_S3_ACCESS_KEY
# BACKUP_S3_SECRET_KEY_SECRET_REF=env:BACKUP_S3_SECRET_KEY
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_WAREHOUSE_ENDPOINT=
# BACKUP_WAREHOUSE_BUCKET=
# BACKUP_WAREHOUSE_ACCESS_KEY_SECRET_REF=env:BACKUP_WAREHOUSE_ACCESS_KEY
# BACKUP_WAREHOUSE_SECRET_KEY_SECRET_REF=env:BACKUP_WAREHOUSE_SECRET_KEY
# BACKUP_WAREHOUSE_ACCESS_KEY=
# BACKUP_WAREHOUSE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Tenant storage on outside S3
# ─────────────────────────────────────────────────────────────────────────
#
# Where a tenant's own Lakekeeper warehouse lives. The bucket MUST NOT
# equal `LAKEHOUSE_WAREHOUSE_BUCKET` (the shared warehouse claims that
# bucket's root, and Lakekeeper refuses an overlapping warehouse). Unset
# with the access pair above empty, tenant provisioning refuses honestly.
#
# Every setting: docs/CONFIGURATION.md#tenant-storage
# TENANT_WAREHOUSE_S3_ENDPOINT=http://rustfs:9000
# TENANT_WAREHOUSE_S3_BUCKET=lakehouse-tenant-warehouses
# TENANT_WAREHOUSE_S3_REGION=us-east-1
# TENANT_WAREHOUSE_S3_PATH_STYLE_ACCESS=true
# TENANT_WAREHOUSE_STS_ENABLED=true
# TENANT_WAREHOUSE_STS_ROLE_ARN=arn:aws:iam::000000000000:role/lakekeeper

# ─────────────────────────────────────────────────────────────────────────
# Networks you allow — connection tests, webhooks and ingest
# ─────────────────────────────────────────────────────────────────────────
#
# Empty means private/internal addresses are refused, on a fresh install
# too: the seeded demo connectors point at `postgres:5432` and
# `http://rustfs:9000` inside the compose network, so their "Test" is
# refused until you opt in. Prefer the CIDR lists: `*_ALLOW_INTERNAL_HOSTS`
# opens every internal address, loopback and cloud metadata included.
#
# Every setting: docs/CONFIGURATION.md#networks
# CONNECTOR_PROBE_ALLOW_INTERNAL_HOSTS=
# CONNECTOR_PROBE_ALLOWED_CIDRS=
# WEBHOOK_ALLOWED_CIDRS=
# INGEST_ALLOW_INTERNAL_HOSTS=
# INGEST_ALLOWED_CIDRS=
