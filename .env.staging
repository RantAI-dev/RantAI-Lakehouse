# Staging override — appended to .env.example at deploy time.
# Docker Compose auto-loads .env; last definition wins.

# AUTH_BOOTSTRAP_PASSWORD is NOT committed here (SEC-13): the deploy
# workflow injects it from the repo secret STAGING_AUTH_BOOTSTRAP_PASSWORD.
AUTH_BOOTSTRAP_EMAIL=staging@rantai.dev

# Move Dagster off 3000 so the Next.js frontend can own that port
DAGSTER_WEBSERVER_HOST_PORT=3001

# The compose default for DAGSTER_URL is the in-network service name
# (`http://dagster-webserver:3000/graphql`, REL-19 review R1). Staging still
# names it explicitly so the intent is visible here and a template that set
# the old host-side address cannot leak in; inside the compose network the
# API must reach the webserver by service name. Wrong value =
# DgError::Transport ("fetch failed") on every Dagster read:
# GET /api/overview answered 503 and the Home banner showed "could not check
# datasets".
DAGSTER_URL=http://dagster-webserver:3000/graphql

# Connection-test guard (routes::connector_probe, SEC-15): by default the API
# refuses to dial private/internal addresses, so testing a connector that
# points at an office-LAN host (e.g. a Postgres at 192.168.18.105) is refused
# with "refusing to dial ... private/internal address". Staging IS a trusted
# internal deployment, so name the two ranges that legitimately need to be
# reachable: the office LAN (user connectors) and the compose network itself
# (in-stack hosts like `postgres:5432` / `rustfs:9000` resolve there).
CONNECTOR_PROBE_ALLOWED_CIDRS=192.168.18.0/24,172.18.0.0/16

# The host-dev default is localhost (`config.rs`). Inside the compose
# network the services that write Bronze must reach Lakekeeper by
# service name.
LAKEKEEPER_CATALOG_URI=http://lakekeeper:8181/catalog

# --- Service credentials ---------------------------------------------------
# The fresh-install template does not set these, which leaves every scheduled pipeline
# inert ("schedule stays inert until then" in the API startup log) and
# /api/pipelines/* answering 401/503. The same .env feeds both the API and
# the Dagster profile, so one value per token keeps both sides in sync.
#
# The values are NOT committed here (SEC-13: this repo is public). The
# deploy workflow injects each from a repo secret named STAGING_<NAME>:
#   AGENT_RUN_TOKEN, GOLD_EXPORT_RUN_TOKEN, INGEST_SERVICE_TOKEN,
#   ALERTS_RUN_TOKEN, PIPELINE_RUN_TOKEN, LAKEHOUSE_MAINTENANCE_TOKEN

# Shared catalog owner: with >1 tenant seeded, GET /api/pipelines and the
# catalog list are refused for anyone without the *:* grant until this names
# the owner tenant. `Meridian Group` is the group tenant of
# 0002_seed_identity.sql (docs/OPERATIONS.md "Upgrade note").
CATALOG_TENANT_ID=11111111-1111-4111-8111-000000000001

# Signed dashboard embeds (/api/embed routes are unavailable without it).
# EMBED_SECRET is injected from the repo secret STAGING_EMBED_SECRET (SEC-13).

# NOTE: LLM_KEY / MINIMAX_API_KEY is deliberately NOT committed here - the
# repo is public and a real provider key is a paid credential. The deploy
# workflow injects it from the repo secret `LLM_KEY` (Setup staging .env
# step, appended last so it wins over any LLM_KEY the template carries).
# Without that secret, AI chat / agent / text-to-SQL stay at 503.

# The API container must reach Lakekeeper over the compose network. The
# compose default is now the in-network name (`http://lakekeeper:8181`,
# REL-19 review R1); staging names it explicitly anyway so the intent is
# visible here. `config.rs`'s own default (`http://localhost:8181`) is for a
# dev shell on the host: inside the lakehouse-api container `localhost` is
# the API itself, so every management-API call fails ("error sending
# request" / "fetch failed") and tenant provisioning reports itself
# unavailable. The same value is what Lakekeeper ADVERTISES in its
# `/v1/config`, and every REST catalog client honors that advertisement —
# so it must be the address the clients can reach.
LAKEKEEPER_BASE_URI=http://lakekeeper:8181

# The Dagster-side ingest SSRF guard (ssrf_guard.py) blocks dialing any
# private/internal address by default - same idea as the API's
# CONNECTOR_PROBE_ALLOWED_CIDRS, separate knob. bronze_ingest_job dials
# the source connector's host: the office LAN (e.g. 192.168.18.153) and
# in-stack hosts (seeded connectors point at `postgres:5432`, which
# resolves inside the compose network). Without this, every ingest run
# dies with SsrfBlocked: "refusing to dial 'postgres'".
INGEST_ALLOWED_CIDRS=192.168.18.0/24,172.18.0.0/16

# ── Assistant LLM provider (OpenAI-compatible) ──
# Active: GLM via Z.ai (2026-11-12; MiniMax quota exhausted)
LLM_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.6
# Previous: MiniMax — untuk kembali ke MiniMax, comment 2 baris GLM di
# atas dan uncomment 2 baris di bawah:
# LLM_URL=https://api.minimax.io/v1
# LLM_MODEL=MiniMax-M3

# Console compose tidak boereh mengklaim host port 3000: workflow deploy
# juga menjalankan container `lakehouse-frontend` standalone di 0.0.0.0:3000
# (deploy-staging.yml step "Deploy frontend"). Tanpa ini deploy CI gagal.
CONSOLE_HOST_PORT=3002
