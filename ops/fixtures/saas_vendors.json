          ".workday.com",
          ".myworkday.com"
        ]
      },
      "accountLabel": "Workday host and tenant, as host/tenant",
      "apiBase": "https://{host}",
      "oauth": {
        "authorizeUrl": "https://{host}/{tenant}/authorize",
        "tokenUrl": "https://{host}/ccx/oauth2/{tenant}/token",
        "revocationUrl": null,
        "scopes": [],
        "clientAuth": "post"
      },
      "integration": {
        "secretKey": "integration:workday",
        "secretFields": [
          "username",
          "password"
        ]
      },
      "whoami": null
