{
  "realm": "lakehouse",
  "enabled": true,
  "displayName": "RantAI Lakehouse (SEC-3 gate)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "groups": [
    {
      "name": "analysts",
      "path": "/analysts"
    }
  ],
  "clients": [
    {
      "clientId": "lakehouse",
      "name": "Lakehouse console (SEC-3 gate)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://lakehouse-api:8080/api/auth/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lakehouse-wrongaud",
      "name": "SEC-3 gate: wrong-audience negative case",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "lakehouse-expired",
      "name": "SEC-3 gate: expired-token negative case",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "access.token.lifespan": "5"
      },
      "protocolMappers": [
        {
          "name": "lakehouse-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lakehouse",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@ssogate.invalid",
      "firstName": "Alice",
      "lastName": "Analyst",
      "groups": [
        "/analysts"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@ssogate.invalid",
      "firstName": "Bob",
      "lastName": "Nobody",
      "groups": [],
      "credentials": [
        {
          "type": "password",
          "value": "",
          "temporary": false
        }
      ]
    }
  ]
}
