{
  "_comment": "P2 (G2) SeaweedFS matrix config — local/CI only, not for production. Mirrors the RustFS-side setup (rustfsadmin/rustfsadmin, allow-all role trust) so the storage boundary comparison is apples-to-apples: this is the SeaweedFS analogue of RustFS's own well-known defaults plus its 'accept any sts-role-arn string' behavior, not a real IAM identity. See docker-compose.yml's seaweedfs service and docs/STORAGE-COMPATIBILITY.md.",
  "identities": [
    {
      "name": "seaweedfsadmin",
      "credentials": [
        { "accessKey": "seaweedfsadmin", "secretKey": "seaweedfsadmin" }
      ],
      "actions": ["Admin", "Read", "Write", "List", "Tagging"]
    }
  ],
  "sts": {
    "tokenDuration": "1h",
    "maxSessionLength": "12h",
    "issuer": "seaweedfs-sts",
    "signingKey": "p2-matrix-local-only-signing-key-not-a-secret"
  },
  "policy": {
    "defaultEffect": "Deny",
    "storeType": "memory"
  },
  "policies": [
    {
      "name": "LakehouseWarehouseAccess",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": ["s3:*"],
            "Resource": ["*"]
          }
        ]
      }
    }
  ],
  "roles": [
    {
      "roleName": "lakekeeper",
      "roleArn": "arn:aws:iam::000000000000:role/lakekeeper",
      "attachedPolicies": ["LakehouseWarehouseAccess"],
      "trustPolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": { "AWS": "*" },
            "Action": ["sts:AssumeRole"]
          }
        ]
      }
    }
  ]
}
