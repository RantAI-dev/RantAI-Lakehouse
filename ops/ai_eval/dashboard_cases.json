[
  {
    "id": "dash_list_boards",
    "mode": "ask",
    "setup": [
      {"name": "board", "method": "POST", "path": "/api/dashboard/boards", "body": {"name": "Eval Board List"}, "id_at": "board.id"}
    ],
    "turns": ["Which dashboards are there?"],
    "facts": [
      {"label": "board", "kind": "text", "values": ["Eval Board List"]}
    ]
  },
  {
    "id": "dash_charts_on_board",
    "mode": "ask",
    "setup": [
      {"name": "board", "method": "POST", "path": "/api/dashboard/boards", "body": {"name": "Eval Board Charts"}, "id_at": "board.id"},
      {"name": "chart_a", "method": "POST", "path": "/api/dashboard/specs", "body": {"title": "Eval Events Total A", "kind": "kpi", "mart": "mart_event", "measures": ["jumlah_event"], "board": "{board}"}, "id_at": "chart.id"},
      {"name": "chart_b", "method": "POST", "path": "/api/dashboard/specs", "body": {"title": "Eval Events Per Year B", "kind": "bar", "mart": "mart_event", "dimension": "tahun", "measures": ["jumlah_event"], "board": "{board}"}, "id_at": "chart.id"}
    ],
    "turns": ["What charts are on board {board}?"],
    "facts": [
      {"label": "title", "kind": "text", "values": ["Eval Events Total A", "Eval Events Per Year B"]}
    ]
  },
