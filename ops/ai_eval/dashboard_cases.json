    "expect_state": [
      {"path": "/api/dashboard/calc-fields?mart=mart_event", "list": "fields", "where": {"name": "ratio"}, "count": 1}
    ],
    "forbid": ["SELECT"]
  },
  {
    "id": "calc_validate_error",
    "mode": "build",
