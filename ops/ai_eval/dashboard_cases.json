  {
    "id": "calc_create",
    "mode": "build",
    "confirm": true,
    "setup": [
      {"name": "src", "method": "POST", "path": "/api/dashboard/sources", "body": {"title": "Eval Source Ratio", "sql": "SELECT tahun, jumlah_event, jumlah_event * 2 AS dua FROM serving.mart_event"}, "id_at": "source.id"}
